@final
class Archive:
    def __init__(self, _unconstructible: Never, /) -> None: ...
    @property
    def documents(self) -> list[DocumentInfo] | list[PackageDocument]: ...
    @property
    def references(self) -> list[ReferenceInfo]: ...
    def read_package(self, *, strict: bool | None = None) -> PackageInfo: ...
    def open_document(
        self, document_id: str, *, strict: bool | None = None
    ) -> Archive: ...
    @property
    def root_document_id(self) -> str | None: ...
    def read_document(self, *, strict: bool | None = None) -> DocumentInfo: ...
    def read_span(self, region: RawSpan) -> bytes: ...
    def get_preview(
        self, *, document_id: str | None = None, strict: bool | None = None
    ) -> bytes | None: ...
    @property
    def kind(self) -> ArchiveKind: ...
    @property
    def exit_code(self) -> ExitCode: ...
    @property
    def status(self) -> Status: ...
    @property
    def source(self) -> str: ...
    @property
    def source_sha256(self) -> str: ...
    @property
    def source_size(self) -> int: ...
    @property
    def members(self) -> list[MemberInfo]: ...
    @property
    def issues(self) -> list[Diagnostic]: ...
    def read_member(self, name: str) -> bytes: ...
    def verify(
        self, *, strict: bool = True, recursive: bool = True
    ) -> ValidationReport: ...
    def to_json(self) -> str: ...
    def to_dict(self) -> ArchiveJSON: ...

@final
class ValidationReport:
    def __init__(self, _unconstructible: Never, /) -> None: ...
    @property
    def exit_code(self) -> ExitCode: ...
    @property
    def status(self) -> Status: ...
    @property
    def scope(self) -> ValidationScope: ...
    @property
    def source_sha256(self) -> str: ...
    @property
    def members_total(self) -> int: ...
    @property
    def members_verified(self) -> int: ...
    @property
    def bytes_decompressed(self) -> int: ...
    @property
    def issues(self) -> list[Diagnostic]: ...
    @property
    def nested_archives(self) -> Literal["complete", "partial", "not_requested"]: ...
    def to_json(self) -> str: ...
    def to_dict(self) -> ValidationJSON: ...

class FusionError(Exception):
    code: str
    stage: str
    member: str | None
    offset: int | None
    source: str | None
    message: str
    diagnostic: DiagnosticJSON
    offset_basis: OffsetBasis | None
    context: str | None
    status: Status
    exit_code: ExitCode
    issues: list[Diagnostic]
    result: ErrorJSON
    report: ValidationReport | None

class FormatError(FusionError): ...
class UnsupportedFeatureError(FusionError): ...
class ResourceLimitError(FusionError): ...
class ReferenceResolutionError(FusionError): ...

def readfile(
    path: str | PathLike[str], *, limits: Limits | None = None, strict: bool = True
) -> Archive: ...
def read(
    data: bytes, *, limits: Limits | None = None, strict: bool = True
) -> Archive: ...

